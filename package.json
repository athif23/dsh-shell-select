{
  "name": "dsh-shell-select",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: one model-facing `shell` tool whose shell is a user setting. Resolves and validates through the harness's own seams, and refuses to run when the selected shell cannot be confined.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "shell",
    "bash",
    "zsh",
    "fish",
    "powershell",
    "pwsh",
    "cmd",
    "git-bash",
    "wsl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/athif23/dsh-shell-select.git"
  },
  "bugs": {
    "url": "https://github.com/athif23/dsh-shell-select/issues"
  },
  "homepage": "https://github.com/athif23/dsh-shell-select#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "test": "node --test \"test/**/*.spec.mjs\"",
    "test:execution": "node --test test/integration.spec.mjs test/cmd-command-transport.spec.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-bash-local": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-jobs": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-pwsh-local": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-shell": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-shell-env": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-bash-local": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-pwsh-local": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox-local": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-settings-file": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-shell": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-subprocess-local": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-bash-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-pwsh-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell-env": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
